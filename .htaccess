# Affreso — Apache configuration
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Never serve application code, configuration, uploads or logs directly.
    RewriteRule ^(app|config|storage|database|tools|lang|docs)(/|$) - [F,L]
    # Optional "pretty" URLs (enable 'pretty_urls' => true in config/config.php).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(sql|md|log|lock|dist|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
